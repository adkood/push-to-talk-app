# Optional: When running the client separately from the backend (e.g. on Vercel, Netlify, or local Vite dev pointing to Render)
# Format can be: wss://<your-service>.onrender.com or https://<your-service>.onrender.com
# If left empty, defaults to same host /ws (for single-service deployment or local proxy)
VITE_WS_URL=
